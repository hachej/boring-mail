{
  "name": "@hachej/boring-mail",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22 <23"
  },
  "os": ["linux"],
  "description": "Agent-native Boring UI mail workbench plugin with .mail.md draft surfaces and an agent mail tool.",
  "exports": {
    "./front": "./src/boring-ui/front.tsx",
    "./server": "./src/boring-ui/server.ts",
    "./mail-agent-tool": "./src/mail/server/mailAgentTool.ts",
    "./mail-store": {
      "types": "./dist/mail/store/productDb.d.ts",
      "import": "./dist/mail/store/productDb.js",
      "default": "./dist/mail/store/productDb.js"
    }
  },
  "files": ["src", "dist"],
  "boring": {
    "id": "boring-mail",
    "label": "Mail",
    "front": "src/boring-ui/front.tsx",
    "server": "src/boring-ui/server.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.worker.json && node scripts/smoke-mail-store-worker.mjs",
    "prebenchmark:unified-inbox": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.worker.json",
    "benchmark:unified-inbox": "node scripts/benchmark-unified-inbox.mjs",
    "smoke:msgvault-direct": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke-msgvault-direct.mjs",
    "smoke:msgvault-direct:required": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke-msgvault-required.mjs",
    "smoke:msgvault-required": "pnpm smoke:msgvault-direct:required",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hachej/boring-workspace": "0.1.103",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "jsdom": "^29.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
